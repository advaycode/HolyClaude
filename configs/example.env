# HolyClaude environment variables
# Copy to .env at repo root — never commit .env

# Obsidian vault path (used by KnowledgeWriter + MCP hub)
HOLY_VAULT=C:/Users/advay/Obsidian/Claude/Memory

# Ollama endpoint (default: localhost)
OLLAMA_HOST=http://localhost:11434

# Encoding fix for emoji-heavy Python scripts on Windows
PYTHONIOENCODING=utf-8

# Optional: external API keys (leave blank to use local-only)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
