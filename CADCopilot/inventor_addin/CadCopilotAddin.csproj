<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CadCopilotAddin</AssemblyName>
    <RootNamespace>CadCopilot</RootNamespace>
    <!-- COM-visible so Inventor can instantiate the add-in by ClassId -->
    <ComVisible>true</ComVisible>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adjust the version folder if you target Inventor 2026 instead of 2027. -->
    <!-- EmbedInteropTypes=true makes ONE DLL work across Inventor 2026 + 2027
         (binds to the stable COM type-library GUIDs, not a version-specific PIA).
         The HintPath just needs ANY installed Inventor's interop to compile against. -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>C:\Program Files\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Lets `dotnet build` target net48 without a full .NET Framework dev pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
